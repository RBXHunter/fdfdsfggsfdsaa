-- ===== АНИМАЦИЯ: пошаговый переход по кадрам =====

local function stepFrame()
    if not runAnimTrack or not runAnimTrack.IsPlaying then return end
    currentFrame = currentFrame + 1

    -- Переводим TimePosition на нужный кадр
    local targetTime = (currentFrame - 1) * frameLen
    -- Зажимаем в пределах длины анимации
    if frameLen > 0 then
        runAnimTrack.TimePosition = math.clamp(targetTime, 0, runAnimTrack.Length - 0.01)
    end

    -- После 24-го кадра — юзаем скилл и сбрасываем счётчик
    if currentFrame >= TOTAL_FRAMES then
        currentFrame = 0
        fireSkill1()
    end
end

-- ===== СТАРТ / СТОП =====

local function startRunning()
    if not _G.isScriptEnabled or not humanoid then return end
    holding = true
    currentFrame = 0

    -- Загружаем анимацию
    if runAnimTrack then runAnimTrack:Stop(); runAnimTrack:Destroy(); runAnimTrack = nil end

    local anim = Instance.new("Animation")
    anim.AnimationId = RUN_ANIM_ID
    runAnimTrack = humanoid:LoadAnimation(anim)
    runAnimTrack.Looped = true
    runAnimTrack:Play()

    -- Ждём загрузки длины
    local t = tick()
    while runAnimTrack.Length == 0 and tick() - t < 2 do
        task.wait(0.05)
    end

    if runAnimTrack.Length == 0 then
        warn("[naoya_run] Анимация не загрузилась")
        return
    end

    -- Длина одного "кадра" = длина анимации / 24
    frameLen = runAnimTrack.Length / TOTAL_FRAMES
    -- Начинаем с паузы (останавливаем автовоспроизведение, управляем вручную)
    runAnimTrack:AdjustSpeed(0)
    runAnimTrack.TimePosition = 0

    -- Спидбуст
    stopBoostLoop()
    boostConn = RunService.Heartbeat:Connect(function()
        if _G.isScriptEnabled and holding and humanoid then
            humanoid.WalkSpeed = 16 + RUN_SPEED_BOOST
        end
    end)

    -- Главный цикл: каждые FRAME_INTERVAL секунд — шаг кадра
    task.spawn(function()
        while holding and _G.isScriptEnabled do
            stepFrame()
            task.wait(FRAME_INTERVAL)
        end
    end)
end

local function stopRunning()
    holding = false
    currentFrame = 0

    stopBoostLoop()

    if runAnimTrack then
        runAnimTrack:Stop()
        runAnimTrack:Destroy()
        runAnimTrack = nil
    end

    if humanoid then
        humanoid.WalkSpeed = 36
    end
end

-- ===== ВВОД =====

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not _G.isScriptEnabled then return end
    if input.KeyCode == Enum.KeyCode.Z and not holding then
        startRunning()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Z then
        stopRunning()
    end
end)

-- ===== ПЕРСОНАЖ =====

local function onCharacterAdded(character)
    humanoid = character:WaitForChild("Humanoid")
    stopRunning()
end

if player.Character then
    onCharacterAdded(player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)

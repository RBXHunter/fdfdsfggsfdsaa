local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- CONFIG
local RUN_ANIM_ID     = "rbxassetid://17354976067"
local TOTAL_FRAMES    = 24       -- количество кадров на цикл
local FRAME_INTERVAL  = 0.3     -- секунд между кадрами
local RUN_SPEED_BOOST = 150
local SKILL_KEY       = Enum.KeyCode.One  -- кнопка первого скилла в TSB

-- STATE
local holding       = false
local currentFrame  = 0
local runAnimTrack  = nil
local boostConn     = nil
local humanoid      = nil
local frameLen      = 0   -- длина одного кадра в секундах анимации, заполнится после загрузки

-- ===== UTIL =====

local function stopBoostLoop()
    if boostConn then boostConn:Disconnect(); boostConn = nil end
end

-- Проверяем кулдаун первого скилла по хотбару TSB
local function isSkill1Ready()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return true end
    local hotbar = pg:FindFirstChild("Hotbar")
    if not hotbar then return true end
    local slot = hotbar:FindFirstChild("Backpack")
        and hotbar.Backpack:FindFirstChild("Hotbar")
        and hotbar.Backpack.Hotbar:FindFirstChild("1")
    if not slot then return true end
    local base = slot:FindFirstChild("Base")
    if not base then return true end
    -- Кулдаун-фрейм: Size.Y.Scale == 0 означает готов
    local cd = base.Parent:FindFirstChild("Cooldown")
    if cd then
        return cd.Size.Y.Scale == 0
    end
    return true
end

